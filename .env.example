# Copy this file to .env and fill in real values
# DO NOT commit .env to git (it's in .gitignore)

# ─────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# When running api locally and postgres in docker: HOST=localhost
# When running api inside docker: HOST=postgres (the service name)
DATABASE_URL=postgresql+asyncpg://cvuser:cvpass@localhost:5432/cv_inference

# ─────────────────────────────────────────────────────
# Redis (used as Celery broker AND pub/sub for WebSocket)
# ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────
# Celery
# ─────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─────────────────────────────────────────────────────
# API config
# ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# ─────────────────────────────────────────────────────
# Storage paths (for uploaded and annotated images)
# ─────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
ANNOTATED_DIR=./annotated
MODELS_CACHE_DIR=./models_cache
